#include <stdio.h>
#include <string.h>

#define MAX_STUDENTS 50
#define SUBJECTS 3
#define NAME_LEN 50

typedef struct {
    int roll_no;
    char name[NAME_LEN];
    float marks[SUBJECTS];
    float total;
    float percentage;
    char grade;
    int passed;
} Student;

char computeGrade(float pct, int passed) {
    if (!passed) return 'F';
    if (pct >= 90.0f) return 'A';
    if (pct >= 75.0f) return 'B';
    if (pct >= 60.0f) return 'C';
    if (pct >= 40.0f) return 'D';
    return 'E';
}

void evaluateStudent(Student *s) {
    s->total = 0.0f;
    s->passed = 1;

    for (int i = 0; i < SUBJECTS; i++) {
        s->total += s->marks[i];
        if (s->marks[i] < 40.0f) {
            s->passed = 0;
        }
    }

    s->percentage = s->total / SUBJECTS;
    s->grade = computeGrade(s->percentage, s->passed);
}

int main(void) {
    Student students[MAX_STUDENTS];
    int n;

    printf("Enter number of students (1 to %d): ", MAX_STUDENTS);
    if (scanf("%d", &n) != 1 || n < 1 || n > MAX_STUDENTS) {
        printf("Invalid student count.\n");
        return 1;
    }

    for (int i = 0; i < n; i++) {
        printf("\n--- Student %d ---\n", i + 1);
        printf("Roll Number: ");
        if (scanf("%d", &students[i].roll_no) != 1) {
            printf("Invalid roll number.\n");
            return 1;
        }

        while (getchar() != '\n'); /* Clear newline before fgets */
        printf("Name: ");
        if (fgets(students[i].name, sizeof(students[i].name), stdin) != NULL) {
            students[i].name[strcspn(students[i].name, "\n")] = '\0';
        }

        for (int j = 0; j < SUBJECTS; j++) {
            printf("Marks in Subject %d (0-100): ", j + 1);
            if (scanf("%f", &students[i].marks[j]) != 1 ||
                students[i].marks[j] < 0.0f || students[i].marks[j] > 100.0f) {
                printf("Invalid marks.\n");
                return 1;
            }
        }

        evaluateStudent(&students[i]);
    }

    printf("\n%-8s %-20s %-8s %-10s %-7s %-8s\n",
           "Roll", "Name", "Total", "Percent", "Grade", "Status");
    printf("--------------------------------------------------------------------\n");

    for (int i = 0; i < n; i++) {
        printf("%-8d %-20s %-8.2f %-9.2f%% %-7c %-8s\n",
               students[i].roll_no,
               students[i].name,
               students[i].total,
               students[i].percentage,
               students[i].grade,
               students[i].passed ? "PASS" : "FAIL");
    }

    return 0;
}
